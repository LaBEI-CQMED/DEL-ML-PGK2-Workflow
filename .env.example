# Path to the DEL compounds table (parquet).
DXC_DEL_TABLE=/path/to/del_compounds.parquet

# Path to the active-learning labels (csv).
DXC_ACTIVE_LEARNING=/path/to/active_learning_data.csv

# Path to the library to score by default (csv with CatalogID, SMILES).
DXC_TEST_SPLIT=/path/to/PGK2_Test_split.csv

# Worker/thread cap
DXC_JOBS=4
